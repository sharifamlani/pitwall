# Pitwall dev-tooling settings. Copy to .env and fill in. The extension itself never reads this file.

# Where Claude Code stores session files. Windows: C:\Users\<you>\.claude  Container: /home/vscode/.claude-host
PITWALL_CLAUDE_HOME=

# Open VSX token, for publishing where Cursor installs extensions from (Phase 5; leave empty until then)
OVSX_PAT=

# VS Code Marketplace token (optional, Phase 5)
VSCE_PAT=
