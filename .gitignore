# Secrets — .env holds local values; only the documented template is tracked
.env
.env.*
!.env.example
token.json
credentials.json
.credentials.json
*.pem
*.key
.npmrc
.netrc
id_rsa*
id_ed25519*
*.p12
*.pfx

# Python (dev tooling under tools/, managed by Poetry)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node / extension build output (mirrors Pitwall's ignores so the Phase 1 import merges cleanly)
node_modules/
out/
dist/
*.vsix
.vscode-test/
test/dry/.build/
_site/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Private, local-only — this repo is PUBLIC; none of these may ever be committed
# transcripts: planning conversations (both casings, so Linux containers match too)
/transcripts/
/Transcripts/
# .packages: local connector scripts; may hold local credentials
/.packages/
# .claude: per-machine Claude Code settings, skills and locks; only the extension's own pitwall-* skills are tracked
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/pitwall-*/
# .superpowers: plan-execution scratch (ledgers, briefs, review packages)
/.superpowers/
# Playwright MCP runtime dumps
.playwright-mcp/

# public: third-party repos cloned for reference (license-checked before any code is copied)
/public/
