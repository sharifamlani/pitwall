{
  "name": "pitwall",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "mounts": [
    "source=pitwall-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude-host,type=bind,readonly"
  ],
  "containerEnv": {
    "PITWALL_CLAUDE_HOME": "/home/vscode/.claude-host"
  },
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && poetry install --no-interaction",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint"]
    }
  }
}
